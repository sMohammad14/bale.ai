(async function() {
  // ============================================================
  // 📋 لیست UIDهایی که باید به آن‌ها پیام ارسال شود (خالی بگذار)
  // ============================================================
  const TARGET_UID_LIST = [
    // UIDها را اینجا اضافه کن، مثال:
    // "52", "4532", "34545"
  ];

  // ============================================================
  // ⛔ لیست UIDهایی که نباید پیام بگیرند (خالی بگذار)
  // ============================================================
  const SKIP_UID_LIST = [
    // UIDها را اینجا اضافه کن، مثال:
    // "49538", "327373", "1885507"
  ];
  const SKIP_UID_SET = new Set(SKIP_UID_LIST.map(String));

  // ⏱️ فاصله بررسی المنت‌ها (میلی‌ثانیه)
  const POLL_INTERVAL = 50;

  // ⏱️ حداکثر زمان انتظار برای ظاهر شدن نام مخاطب (میلی‌ثانیه)
  const TIMEOUT_CONTACT_NAME = 45000;

  // ⏱️ حداکثر زمان انتظار برای ظاهر شدن باکس پیام (میلی‌ثانیه)
  const TIMEOUT_MESSAGE_BOX = 30000;

  // ⏱️ حداکثر زمان انتظار برای ظاهر شدن دکمه ارسال (میلی‌ثانیه)
  const TIMEOUT_SEND_BUTTON = 10000;

  // ⏱️ تأخیر بعد از رفتن به صفحه مخاطب (بازه min-max میلی‌ثانیه)
  const DELAY_AFTER_NAVIGATION_RANGE = "50-200";

  // ⏱️ تأخیر قبل از نوشتن متن (بازه min-max میلی‌ثانیه)
  const DELAY_BEFORE_TYPING_RANGE = "50-200";

  // ⏱️ تأخیر قبل از کلیک روی ارسال (بازه min-max میلی‌ثانیه)
  const DELAY_BEFORE_SEND_RANGE = "50-200";

  // ⏱️ تأخیر بعد از ارسال (بازه min-max میلی‌ثانیه)
  const DELAY_AFTER_SEND_RANGE = "50-200";

  // ⏱️ تأخیر تصادفی بین تایپ هر کاراکتر (بازه min-max میلی‌ثانیه)
  const CHAR_TYPING_DELAY_RANGE = "1-5";

  // ⏱️ بازه تعداد پیام‌ها قبل از مکث (به‌صورت min-max)
  const PAUSE_AFTER_N_MESSAGES_RANGE = "6000-7000";

  // ⏱️ مدت‌زمان مکث (بازه min-max میلی‌ثانیه)
  const PAUSE_DURATION_RANGE = "5400000-10800000";

  // 💾 کلید localStorage برای ذخیره UIDهای ارسال‌شده
  const SENT_UID_STORAGE_KEY = 'sentUIDs';


  const MESSAGE_TEMPLATES = [
    `سلام name_of_contact، وقت بخیر
پیام 1`,

    `سلام name_of_contact، وقت بخیر
پیام 2`,

    `سلام name_of_contact، احتراماً
پیا 3`,

    `سلام name_of_contact، وقت بخیر
پیام 4`,

    `سلام name_of_contact، وقت شما بخیر
پام 5`,

    `سلام name_of_contact، ارادت داریم
پیام 6`,

    `سلام name_of_contact، وقت بخیر
پیام 7`,

    `سلام name_of_contact، احتراماً
پیام 8.`,

    `سلام name_of_contact، وقت بخیر
پیام 9`,

    `سلام name_of_contact، وقت شما بخیر
پیام 10`,

    `سلام name_of_contact، ارادت داریم
پیام 11`,

    `سلام name_of_contact، وقت بخیر
پیام 12`,

    `سلام name_of_contact، احتراماً
پیام 13`,

    `سلام name_of_contact، وقت شما بخیر
پیام 14`,

    `سلام name_of_contact، ارادت داریم
پیام 15`
  ];

  const sleep = ms => new Promise(resolve => setTimeout(resolve, ms));

  // تبدیل بازه "min-max" به عدد تصادفی
  function getRandomDelay(rangeStr) {
    const parts = rangeStr.split('-');
    const min = parseInt(parts[0], 10);
    const max = parts.length > 1 ? parseInt(parts[1], 10) : min;
    if (isNaN(min) || isNaN(max)) return 1000;
    if (min === max) return min;
    return Math.floor(Math.random() * (max - min + 1)) + min;
  }

  // انتظار فعال تا ظاهر شدن یک المنت
  async function waitForElement(selector, timeout) {
    const start = Date.now();
    while (Date.now() - start < timeout) {
      const el = document.querySelector(selector);
      if (el && el.offsetParent !== null) return el;
      await sleep(POLL_INTERVAL);
    }
    throw new Error(`Timeout waiting for ${selector}`);
  }

  // رفتن به صفحه چت با UID مشخص بدون رفرش کامل
  function navigateToContact(uid) {
    const url = `https://web.bale.ai/chat?uid=${uid}`;
    history.pushState({}, '', url);
    window.dispatchEvent(new PopStateEvent('popstate'));
  }

  // تایپ متن کاراکتر به کاراکتر با تأخیر تصادفی
  async function setMessageText(text) {
    const editable = document.querySelector('#editable-message-text');
    if (!editable) throw new Error('Message box not found.');

    editable.focus();
    editable.textContent = '';

    for (const char of text) {
      editable.textContent += char;
      editable.dispatchEvent(new InputEvent('input', { bubbles: true }));
      await sleep(getRandomDelay(CHAR_TYPING_DELAY_RANGE));
    }
  }

  // بارگیری لیست UIDهای ارسال‌شده از localStorage
  function loadSentUIDs() {
    try {
      const data = localStorage.getItem(SENT_UID_STORAGE_KEY);
      return data ? JSON.parse(data) : [];
    } catch (e) {
      console.warn('Failed to load sent UIDs from localStorage:', e);
      return [];
    }
  }

  // ذخیره لیست UIDهای ارسال‌شده در localStorage
  function saveSentUIDs(uidSet) {
    try {
      localStorage.setItem(SENT_UID_STORAGE_KEY, JSON.stringify(Array.from(uidSet)));
    } catch (e) {
      console.warn('Failed to save sent UIDs to localStorage:', e);
    }
  }

  // ============================================================
  // 🧠 لیست UIDهای ارسال‌شده در حافظه (از localStorage بارگیری می‌شود)
  // این تعریف بالاتر آمده تا دستورهای کنسول حتی وقتی لیست هدف خالی
  // است (و اسکریپت زودتر return می‌کند) بتوانند از آن استفاده کنند.
  // ============================================================
  const sentUIDSet = new Set(loadSentUIDs().map(String));

  // ============================================================
  // 🖥️ دستورهای کنسول
  // ============================================================

  // نمایش لیست UIDهای ارسال‌شده به فرمت ["52","4532","34545"]
  window.getSentUIDs = function() {
    const list = loadSentUIDs().map(String);
    const formatted = JSON.stringify(list);
    console.log(formatted);
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(formatted).then(
        () => console.log('✅ لیست UID در کلیپ‌بورد کپی شد.'),
        () => {}
      );
    }
    return formatted;
  };

  // 🧹 پاک کردن کامل لیست UIDهای ارسال‌شده (هم از localStorage هم از حافظه)
  window.clearSentUIDs = function() {
    try {
      localStorage.removeItem(SENT_UID_STORAGE_KEY);
    } catch (e) {
      console.warn('Failed to remove sent UIDs from localStorage:', e);
    }
    try {
      sentUIDSet.clear();
    } catch (e) {
      console.warn('Failed to clear in-memory sent UID set:', e);
    }
    console.log('🧹 لیست UIDهای ارسال‌شده پاک شد.');
    return [];
  };

  // دانلود فایل txt حاوی UIDهای ارسال‌شده
  function downloadSentUIDs(sentUIDs) {
    if (!sentUIDs.length) {
      console.log('No UIDs were sent, nothing to download.');
      return;
    }
    const content = JSON.stringify(sentUIDs.map(String));
    const blob = new Blob([content], { type: 'text/plain;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `sent_uids_${new Date().toISOString().replace(/[:.]/g, '-')}.txt`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
    console.log(`Downloaded sent UIDs (${sentUIDs.length}).`);
  }

  // ===== شروع عملیات =====
  console.log('Building target UID list...');

  const targetUIDs = Array.from(
    new Set(TARGET_UID_LIST.map(String))
  ).filter(uid => !SKIP_UID_SET.has(uid));

  if (targetUIDs.length === 0) {
    console.log('✅ لیست هدف خالی است؛ عملیات ارسال انجام نمی‌شود.');
    console.log('دستورهای موجود در کنسول:');
    console.log('  getSentUIDs()    → نمایش لیست UIDهای ارسال‌شده');
    console.log('  clearSentUIDs()  → پاک کردن لیست UIDهای ارسال‌شده');
    console.log(`تعداد UIDهای ذخیره‌شده در حافظه: ${sentUIDSet.size}`);
    return;
  }

  console.log(`Total target list: ${TARGET_UID_LIST.length}`);
  console.log(`After skip filter: ${targetUIDs.length} UIDs will be processed.`);

  console.log(`Loaded ${sentUIDSet.size} previously sent UIDs from localStorage.`);

  console.log('To stop manually, type stopSending() in console.');
  console.log('To get sent UIDs in JSON format, type getSentUIDs() in console.');
  console.log('To clear sent UIDs, type clearSentUIDs() in console.');

  let stopRequested = false;
  window.stopSending = () => { stopRequested = true; };

  let sentCount = 0;
  let skippedCount = 0;
  let messagesSinceLastPause = 0;
  let nextPauseAfter = getRandomDelay(PAUSE_AFTER_N_MESSAGES_RANGE);
  console.log(`First pause will occur after ${nextPauseAfter} messages.`);

  for (let i = 0; i < targetUIDs.length; i++) {
    if (stopRequested) {
      console.log('Stopped by user.');
      break;
    }

    const uid = targetUIDs[i];

    if (sentUIDSet.has(uid)) {
      console.log(`⏭️ Skipping ${uid} (already sent before).`);
      continue;
    }

    console.log(`\nProcessing ${i + 1}/${targetUIDs.length} | UID: ${uid}`);

    try {
      navigateToContact(uid);
      const navDelay = getRandomDelay(DELAY_AFTER_NAVIGATION_RANGE);
      console.log(`Navigation delay: ${navDelay} ms`);
      await sleep(navDelay);

      let contactName = '';
      try {
        console.log('Waiting for contact name...');
        const nameElement = await waitForElement('.nMlHDG', TIMEOUT_CONTACT_NAME);
        contactName = nameElement.textContent.trim();
        console.log(`Contact name: ${contactName}`);
      } catch (e) {
        console.warn(`⚠️ Skipping ${uid}: contact name not found (${e.message})`);
        skippedCount++;
        continue;
      }

      const randomTemplate = MESSAGE_TEMPLATES[
        Math.floor(Math.random() * MESSAGE_TEMPLATES.length)
      ];
      const finalMessage = randomTemplate.replaceAll('name_of_contact', contactName);

      try {
        console.log('Waiting for message box...');
        await waitForElement('#editable-message-text', TIMEOUT_MESSAGE_BOX);
      } catch (e) {
        console.warn(`⚠️ Skipping ${uid}: message box not found (${e.message})`);
        skippedCount++;
        continue;
      }

      const typingDelay = getRandomDelay(DELAY_BEFORE_TYPING_RANGE);
      console.log(`Typing delay: ${typingDelay} ms`);
      await sleep(typingDelay);

      try {
        await setMessageText(finalMessage);
      } catch (e) {
        console.warn(`⚠️ Skipping ${uid}: failed to type message (${e.message})`);
        skippedCount++;
        continue;
      }

      const sendDelay = getRandomDelay(DELAY_BEFORE_SEND_RANGE);
      console.log(`Send delay: ${sendDelay} ms`);
      await sleep(sendDelay);

      let sendButton;
      try {
        console.log('Waiting for send button...');
        sendButton = await waitForElement('[aria-label="send-button"]', TIMEOUT_SEND_BUTTON);
      } catch (e) {
        console.warn(`⚠️ Skipping ${uid}: send button not found (${e.message})`);
        skippedCount++;
        continue;
      }

      sendButton.click();
      console.log(`✅ Message sent to ${uid}.`);

      sentUIDSet.add(uid);
      saveSentUIDs(sentUIDSet);
      sentCount++;
      messagesSinceLastPause++;

      if (messagesSinceLastPause >= nextPauseAfter) {
        const pauseDuration = getRandomDelay(PAUSE_DURATION_RANGE);
        console.log(`Pausing for ${pauseDuration} ms after ${messagesSinceLastPause} messages...`);
        await sleep(pauseDuration);
        console.log('Pause finished.');

        messagesSinceLastPause = 0;
        nextPauseAfter = getRandomDelay(PAUSE_AFTER_N_MESSAGES_RANGE);
        console.log(`Next pause will occur after ${nextPauseAfter} messages.`);
      }

      const afterSendDelay = getRandomDelay(DELAY_AFTER_SEND_RANGE);
      console.log(`After send delay: ${afterSendDelay} ms`);
      await sleep(afterSendDelay);

    } catch (error) {
      console.warn(`⚠️ Unexpected error for UID ${uid}: ${error.message}`);
      skippedCount++;
      continue;
    }
  }

  console.log('\n===== Summary =====');
  console.log(`Sent: ${sentCount}`);
  console.log(`Skipped: ${skippedCount}`);
  console.log(`Total sent UIDs (all time): ${sentUIDSet.size}`);
  console.log('To see UIDs in JSON format, type: getSentUIDs()');
  console.log('To clear sent UIDs, type: clearSentUIDs()');

  downloadSentUIDs(Array.from(sentUIDSet));
  console.log('\nOperation finished.');
})();
