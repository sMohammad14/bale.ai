(async function() {
  // ⏱️ فاصله بررسی المنت‌ها (میلی‌ثانیه)
  const POLL_INTERVAL = 1;

  // ⏱️ حداکثر زمان انتظار برای ظاهر شدن نام مخاطب (میلی‌ثانیه)
  const TIMEOUT_CONTACT_NAME = 45000;

  // ⏱️ حداکثر زمان انتظار برای ظاهر شدن باکس پیام (میلی‌ثانیه)
  const TIMEOUT_MESSAGE_BOX = 50000;

  // ⏱️ حداکثر زمان انتظار برای ظاهر شدن دکمه ارسال (میلی‌ثانیه)
  const TIMEOUT_SEND_BUTTON = 10000;

  // ⏱️ تأخیر بعد از رفتن به صفحه مخاطب (بازه min-max میلی‌ثانیه)
  const DELAY_AFTER_NAVIGATION_RANGE = "2000-18000";

  // ⏱️ تأخیر قبل از نوشتن متن (بازه min-max میلی‌ثانیه)
  const DELAY_BEFORE_TYPING_RANGE = "2000-20000";

  // ⏱️ تأخیر قبل از کلیک روی ارسال (بازه min-max میلی‌ثانیه)
  const DELAY_BEFORE_SEND_RANGE = "2000-40000";

  // ⏱️ تأخیر بعد از ارسال (بازه min-max میلی‌ثانیه)
  const DELAY_AFTER_SEND_RANGE = "2000-53000";

  // ⏱️ تأخیر تصادفی بین تایپ هر کاراکتر (بازه min-max میلی‌ثانیه)
  const CHAR_TYPING_DELAY_RANGE = "20-80";

  // ⏱️ مکث بعد از هر N ارسال موفق
  const PAUSE_AFTER_N_MESSAGES = 100;

  // ⏱️ مدت‌زمان مکث (بازه min-max میلی‌ثانیه)
  const PAUSE_DURATION_RANGE = "7200000-18000000";

  // 🗄️ اطلاعات دیتابیس IndexedDB
  const INDEXEDDB_NAME = 'db';
  const INDEXEDDB_STORE_NAME = 'contacts';

  // 💾 کلید localStorage برای ذخیره UIDهای ارسال‌شده
  const SENT_UID_STORAGE_KEY = 'sentUIDs';

  // ⛔ مجموعه UIDهایی که نباید پیام بگیرند
  const SKIP_UID_SET = new Set([
    "-1",
    "10",
    "327373"
  ]);

  // قالب‌های پیام – هر بار یکی به‌صورت تصادفی انتخاب می‌شود
  // توجه: کاراکتر x با نام مخاطب جایگزین می‌شود
  const MESSAGE_TEMPLATES = [
    `سلام x نمونه پیام شماره 1`,
    `سلام x نمونه پیام شماره 2`,
    `سلام x نمونه پیام شماره 3`,
    `سلام x نمونه پیام شماره 4`,
    `سلام x نمونه پیام شماره 5`,
    `سلام x نمونه پیام شماره 6`,
    `سلام x نمونه پیام شماره 7`,
    `سلام x نمونه پیام شماره 8`,
    `سلام x نمونه پیام شماره 9`,
    `سلام x نمونه پیام شماره 10`,
    `سلام x نمونه پیام شماره 11`,
    `سلام x نمونه پیام شماره 12`,
    `سلام x نمونه پیام شماره 13`,
    `سلام x نمونه پیام شماره 14`,
    `سلام x نمونه پیام شماره 15`
  ];

  const sleep = ms => new Promise(resolve => setTimeout(resolve, ms));

  // تبدیل بازه "min-max" به عدد تصادفی
  function getRandomDelay(rangeStr) {
    const parts = rangeStr.split('-');
    const min = parseInt(parts[0], 10);
    const max = parts.length > 1 ? parseInt(parts[1], 10) : min;
    if (isNaN(min) || isNaN(max)) return 1000;
    if (min === max) return min;
    return Math.floor(Math.random() * (max - min + 1)) + min;
  }

  // انتظار فعال تا ظاهر شدن یک المنت
  async function waitForElement(selector, timeout) {
    const start = Date.now();
    while (Date.now() - start < timeout) {
      const el = document.querySelector(selector);
      if (el && el.offsetParent !== null) return el;
      await sleep(POLL_INTERVAL);
    }
    throw new Error(`Timeout waiting for ${selector}`);
  }

  // رفتن به صفحه چت با UID مشخص بدون رفرش کامل
  function navigateToContact(uid) {
    const url = `https://web.bale.ai/chat?uid=${uid}`;
    history.pushState({}, '', url);
    window.dispatchEvent(new PopStateEvent('popstate'));
  }

  // تایپ متن کاراکتر به کاراکتر با تأخیر تصادفی
  async function setMessageText(text) {
    const editable = document.querySelector('#editable-message-text');
    if (!editable) throw new Error('Message box not found.');

    editable.focus();
    editable.textContent = '';

    for (const char of text) {
      editable.textContent += char;
      editable.dispatchEvent(new InputEvent('input', { bubbles: true }));

      const charDelay = getRandomDelay(CHAR_TYPING_DELAY_RANGE);
      await sleep(charDelay);
    }
  }

  // خواندن تمام UIDهای مخاطبین از IndexedDB
  function getAllContactUIDs() {
    return new Promise((resolve, reject) => {
      const request = indexedDB.open(INDEXEDDB_NAME);
      request.onerror = () => reject(request.error);
      request.onsuccess = () => {
        const db = request.result;
        let tx;
        try {
          tx = db.transaction(INDEXEDDB_STORE_NAME, 'readonly');
        } catch (e) {
          db.close();
          reject(e);
          return;
        }
        const store = tx.objectStore(INDEXEDDB_STORE_NAME);
        const uids = new Set();
        const cursorRequest = store.openCursor();

        cursorRequest.onerror = () => {
          db.close();
          reject(cursorRequest.error);
        };

        cursorRequest.onsuccess = (event) => {
          const cursor = event.target.result;
          if (cursor) {
            const record = cursor.value;
            const uid = record.id || record.uid || record.userId;
            if (uid !== undefined && uid !== null) {
              uids.add(String(uid));
            }
            cursor.continue();
          } else {
            db.close();
            resolve(Array.from(uids));
          }
        };
      };
    });
  }

  // بارگیری لیست UIDهای ارسال‌شده از localStorage
  function loadSentUIDs() {
    try {
      const data = localStorage.getItem(SENT_UID_STORAGE_KEY);
      return data ? JSON.parse(data) : [];
    } catch (e) {
      console.warn('Failed to load sent UIDs from localStorage:', e);
      return [];
    }
  }

  // ذخیره لیست UIDهای ارسال‌شده در localStorage (به‌صورت یکتا)
  function saveSentUIDs(uidSet) {
    try {
      localStorage.setItem(SENT_UID_STORAGE_KEY, JSON.stringify(Array.from(uidSet)));
    } catch (e) {
      console.warn('Failed to save sent UIDs to localStorage:', e);
    }
  }

  // تابع کمکی برای دسترسی به لیست از کنسول
  window.getSentUIDs = () => {
    const list = loadSentUIDs();
    console.log(list);
    return list;
  };

  // دانلود فایل txt حاوی UIDهای ارسال‌شده
  function downloadSentUIDs(sentUIDs) {
    if (!sentUIDs.length) {
      console.log('No UIDs were sent, nothing to download.');
      return;
    }
    const content = sentUIDs.join('\n');
    const blob = new Blob([content], { type: 'text/plain;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `sent_uids_${new Date().toISOString().replace(/[:.]/g, '-')}.txt`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
    console.log(`Downloaded sent UIDs (${sentUIDs.length}).`);
  }

  // ===== شروع عملیات =====
  console.log('Reading contacts from IndexedDB...');
  let allUIDs = [];
  try {
    allUIDs = await getAllContactUIDs();
  } catch (e) {
    console.error('Failed to read IndexedDB contacts:', e);
    return;
  }

  const targetUIDs = allUIDs.filter(uid => !SKIP_UID_SET.has(uid));

  if (targetUIDs.length === 0) {
    console.error('No target UIDs found or all are in SKIP_UID_SET.');
    return;
  }

  console.log(`Found ${allUIDs.length} contacts, ${targetUIDs.length} will be processed after skip filter.`);

  // بارگیری UIDهای ارسال‌شده قبلی از localStorage
  const sentUIDSet = new Set(loadSentUIDs());
  console.log(`Loaded ${sentUIDSet.size} previously sent UIDs from localStorage.`);

  console.log('To stop manually, type stopSending() in console.');

  let stopRequested = false;
  window.stopSending = () => { stopRequested = true; };

  let sentCount = 0;

  for (let i = 0; i < targetUIDs.length; i++) {
    if (stopRequested) {
      console.log('Stopped by user.');
      break;
    }

    const uid = targetUIDs[i];
    console.log(`\nProcessing ${i + 1}/${targetUIDs.length} | UID: ${uid}`);

    try {
      navigateToContact(uid);

      const navDelay = getRandomDelay(DELAY_AFTER_NAVIGATION_RANGE);
      console.log(`Navigation delay: ${navDelay} ms`);
      await sleep(navDelay);

      console.log('Waiting for contact name...');
      const nameElement = await waitForElement('.nMlHDG', TIMEOUT_CONTACT_NAME);
      const contactName = nameElement.textContent.trim();
      console.log(`Contact name: ${contactName}`);

      // انتخاب تصادفی بر اساس طول فعلی آرایه
      const randomTemplateIndex = Math.floor(Math.random() * MESSAGE_TEMPLATES.length);
      const randomTemplate = MESSAGE_TEMPLATES[randomTemplateIndex];
      const finalMessage = randomTemplate.replaceAll('x', contactName);

      console.log('Waiting for message box...');
      await waitForElement('#editable-message-text', TIMEOUT_MESSAGE_BOX);

      const typingDelay = getRandomDelay(DELAY_BEFORE_TYPING_RANGE);
      console.log(`Typing delay: ${typingDelay} ms`);
      await sleep(typingDelay);

      await setMessageText(finalMessage);

      const sendDelay = getRandomDelay(DELAY_BEFORE_SEND_RANGE);
      console.log(`Send delay: ${sendDelay} ms`);
      await sleep(sendDelay);

      console.log('Waiting for send button...');
      const sendButton = await waitForElement('[aria-label="send-button"]', TIMEOUT_SEND_BUTTON);

      sendButton.click();
      console.log(`Message sent to ${uid}.`);

      // افزودن UID به مجموعه و ذخیره فوری در localStorage
      sentUIDSet.add(uid);
      saveSentUIDs(sentUIDSet);
      sentCount++;

      const afterSendDelay = getRandomDelay(DELAY_AFTER_SEND_RANGE);
      console.log(`After send delay: ${afterSendDelay} ms`);
      await sleep(afterSendDelay);

      if (sentCount % PAUSE_AFTER_N_MESSAGES === 0) {
        const pauseDuration = getRandomDelay(PAUSE_DURATION_RANGE);
        console.log(`Pausing for ${pauseDuration} ms after ${sentCount} messages...`);
        await sleep(pauseDuration);
        console.log('Pause finished.');
      }

    } catch (error) {
      console.error(`Error for UID ${uid}: ${error.message}`);
      console.log('Process stopped due to error. Downloading sent UID list...');
      break;
    }
  }

  downloadSentUIDs(Array.from(sentUIDSet));
  console.log('\nOperation finished.');
})();
